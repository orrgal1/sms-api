# Copy this file to .env and keep it private. The interactive setup writes
# .env with mode 0600; service.py install imports these values into launchd.

# Required destination email address. Use one address only.
FORWARD_TO_EMAIL=you@example.com

# Apple Messages database. The forwarder opens this database read-only.
SMS_MESSAGES_DB=~/Library/Messages/chat.db

# Durable forwarding cursor and pending-delivery queue.
SMS_STATE_DB=./sms_forwarder.sqlite3

# Polling and batching.
SMS_POLL_SECONDS=5
SMS_BATCH_SIZE=100

# Gmail delivery CLI. Use "gapi" or an absolute executable path.
GAPI_BIN=gapi
GAPI_TIMEOUT_SECONDS=120

# Python logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
